          <h1 class=" text-center my-5 text-primary regular2">Расписание</h1>

          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <table id="table">
            <thead>
              <tr>
                <th></th>
                <% daysOfWeekLong.forEach(function(dayOfWeekLong, index){ %>
                  <th> 
                    <% if (datesOfCurrentWeek[index] === todayStr) {%>
                      <span class="day active"><%= datesOfCurrentWeek[index] %></span>
                    <%}else{%>
                      <span class="day"><%= datesOfCurrentWeek[index] %></span>
                    <%}%>
                    <div class="long active"><%= dayOfWeekLong %></div>
                    <div class="short"><%= daysOfWeekShort[index] %></div>
                  </th>
                <% }) %>
                
                
              </tr>
            </thead>
            <tbody>


              <% hoursForTable.forEach(function(time){ %>
                <tr>
                  <td class="hour" rowspan="4"><span><%= time%></span></td>
                  <% for(i = 0; i < 7; i++){ %>
