            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" id="btnСlose" data-bs-dismiss="modal">
                Закрыть
              </button>
              <button class="btn btn-primary btnPhoneModal">
                Проверка
              </button>
            </div>
          </div>
        </div>
      </div>


