                              strDt="<%= sft[counter].strDt %>"
                              strTime="<%= sft[counter].strTime %>"
                              strTeacher="<%= sft[counter].strTeacher %>"
                              tp_lesson="<%= sft[counter].tp_lesson %>"
                              id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                              delBorder='<%= sft[counter].delBorder %>'
                              style="
                                border-left: solid <%= sft[counter].color %>; 
                                box-shadow: 2px 13px 18px -7px  <%= sft[counter].color %>;
                              "
                              >
                              <%/* sft[counter].part */%>
                            </div>
                        <% }else{ %>
                          <div class="ms-1 me-1 ps-1 any" 
                            id="<%= sft[counter].id %>"
                            dtTD="<%= sft[counter].dtTd %>"
                            strDt="<%= sft[counter].strDt %>"
                            strTime="<%= sft[counter].strTime %>"
                            strTeacher="<%= sft[counter].strTeacher %>"
                            tp_lesson="<%= sft[counter].tp_lesson %>"
                            id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                            delBorder='<%= sft[counter].delBorder %>'
                            style="
                              border-left: solid <%= sft[counter].color %>; 
                              box-shadow: 44px 0px 30px -30px <%= sft[counter].color %>;
                            "
                            >
                            <%/* sft[counter].part */%>
                          </div>
                        <% } %>
                      <% } %>
                    </td>
                    <% counter++ %>
                  <% } %>
                </tr>
                <% for(j = 0; j < 3; j++){ %>
                  <tr>
                    <% for(i = 0; i < 7; i++){ %>
                      <td class="<%= sft[counter].dt %>  text-start" >

                        <% if ('id' in sft[counter]) {%>
                          <% if (sft[counter].part == 0){ %>
                              <div class="ms-1 me-1 ps-1 zero" 
                              id="<%= sft[counter].id %>"
                              dtTD="<%= sft[counter].dtTd %>"
                              strDt="<%= sft[counter].strDt %>"
                              strTime="<%= sft[counter].strTime %>"
                              strTeacher="<%= sft[counter].strTeacher %>"
                              tp_lesson="<%= sft[counter].tp_lesson %>"
                              id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                              delBorder='<%= sft[counter].delBorder %>'
                              style="
                                border-left: solid <%= sft[counter].color %>; 
                                box-shadow: 2px 0px 6px 0px  <%= sft[counter].color %>;
                              "
                              >
                              <%= sft[counter].strDt %>  <%= sft[counter].strTime %>
                            </div>
                          <% } else if (sft[counter].part == 1){%>
                            <div class="ms-1 me-1 ps-1 first" 
                              id="<%= sft[counter].id %>"
                              dtTD="<%= sft[counter].dtTd %>"
                              strDt="<%= sft[counter].strDt %>"
                              strTime="<%= sft[counter].strTime %>"
                              strTeacher="<%= sft[counter].strTeacher %>"
                              tp_lesson="<%= sft[counter].tp_lesson %>"
                              id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                              delBorder='<%= sft[counter].delBorder %>'
                              style="
                                border-left: solid <%= sft[counter].color %>; 
                                box-shadow: 44px 0px 30px -30px <%= sft[counter].color %>;
                              "
      
                              >
                              <%= sft[counter].tp_lesson %>
                            </div>
                          <% } else if (sft[counter].part == 2){%>
                            <div class="ms-1 me-1 ps-1 second" 
                              id="<%= sft[counter].id %>"
                              dtTD="<%= sft[counter].dtTd %>"
                              strDt="<%= sft[counter].strDt %>"
                              strTime="<%= sft[counter].strTime %>"
                              strTeacher="<%= sft[counter].strTeacher %>"
                              tp_lesson="<%= sft[counter].tp_lesson %>"
                              id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                              delBorder='<%= sft[counter].delBorder %>'
                              style="
                                font-size: 0.8em;
                                border-left: solid <%= sft[counter].color %>; 
                                box-shadow: 44px 0px 30px -30px black;
                              "
                              >
                              <%= sft[counter].strTeacher %>
                            </div>
                          <% } else if (sft[counter].part == 5){%>
                            <div class="ms-1 me-1 ps-1 five any" 
                              id="<%= sft[counter].id %>"
                              dtTD="<%= sft[counter].dtTd %>"
                              strDt="<%= sft[counter].strDt %>"
                              strTime="<%= sft[counter].strTime %>"
                              strTeacher="<%= sft[counter].strTeacher %>"
                              tp_lesson="<%= sft[counter].tp_lesson %>"
                              id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                              delBorder='<%= sft[counter].delBorder %>'                       
                              style="
                                border-left: solid <%= sft[counter].color %>; 
                                box-shadow: 2px 13px 18px -7px  <%= sft[counter].color %>;
                              "
                              >
                              <%/* sft[counter].part */%>
                            </div>
                          <% }else{ %>
                            <div class="ms-1 me-1 ps-1 any" 
                              id="<%= sft[counter].id %>"
                              dtTD="<%= sft[counter].dtTd %>"
                              strDt="<%= sft[counter].strDt %>"
                              strTime="<%= sft[counter].strTime %>"
                              strTeacher="<%= sft[counter].strTeacher %>"
                              tp_lesson="<%= sft[counter].tp_lesson %>"
                              id_tp_lesson="<%= sft[counter].id_tp_lesson %>"
                              delBorder='<%= sft[counter].delBorder %>'
                              style="
                                border-left: solid <%= sft[counter].color %>; 
                                box-shadow: 44px 0px 30px -30px <%= sft[counter].color %>;
                              "
                              >
                              <%/* sft[counter].part */%>
                            </div>
                          <% } %>
                        <% } %>

                      </td>
                      <% counter++ %>
                    <% } %>
                  </tr>
                <% } %>
              <% }); %>              
            </tbody>
          </table>
        </div>
      </a>

      <a name="tpLessons">
        <div class="container text-start" >
          <h1 class=" text-center my-5 text-primary regular2">Типы занятий</h1>
          <% tp_lessons.forEach(function(tp_lesson) { %>
            <!-- math: isVisible + четность  -->
            <% if (tp_lesson.is_visible==1) { %>
              <% if (tp_lesson.id % 2==1) { %>

                <div class="row align-items-start my-5">
                  <div class="col-4">
                    <img class="img-fluid" src="<%=tp_lesson.src_image%>" alt="beautiful yoga girl">

                  </div>
                  <div class="col-8 ps-5">
                    <h2 class="regular1 text-start text-primary">
                      <%= tp_lesson.name %>
                    </h2>
                    <article class="regular2">
                      <%- tp_lesson.discription %>
                    </article>
                    <div class="pt-3"></div>
                    <button class="btn btn-outline-primary " type="button" onclick="location.href='#timetable'">
                      Записаться
                    </button>
                  </div>
                </div>

                <% } else{ %>
                  <div class="row align-items-start my-5">
                    <div class="col-7 pe-5">
                      <h2 class="regular1 text-start text-primary">
                        <%= tp_lesson.name %>
                      </h2>
                      <article class="regular2">
                        <%- tp_lesson.discription %>
                      </article>
                      <div class="pt-3"></div>
                      <button class="btn btn-outline-primary" type="button" onclick="location.href='#timetable'">
                        Записаться
                      </button>
                    </div>
                    <div class="col-5 ps-5">
                      <img class="img-fluid" src="<%=tp_lesson.src_image%>" alt="beautiful yoga girl">
                    </div>
                  </div>
                  <% } %>
                    <% } %>
                      <% }); %>
        </div>
      </a>

      <%/* Modal for PHONE */ %>
      <div class="modal fade needs-validation" novalidate id="phoneModal" aria-hidden="true"
        aria-labelledby="your_number">

        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title " id="your_number">Введите номер телефона</h5>
              <button type="button" class="btn-close" id="btnСlose" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="ps-3 pe-3">
                <label for="phoneMask">Телефон</label>
                <input type="text" class="form-control i-1 " id="phoneMask" aria-describedby="phoneHelpBlock"
                  placeholder="pip" name="" required>

                <div id="phoneHelpBlock" class="form-text">
                  Введите номер телефона без +7
                </div>

                <div class="valid-feedback">
                  Все хорошо!
                </div>

